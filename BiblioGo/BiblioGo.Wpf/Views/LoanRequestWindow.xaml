<Window x:Class="BiblioGo.Wpf.Views.LoanRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформити заявку на отримання книги" Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=UserIdTextBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Ідентифікатор читача:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="UserIdTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Ідентифікатор книги:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="BookIdTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Ідентифікатор філії:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="LibraryIdTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <Button x:Name="CreateLoanRequestButton" Content="Оформити заявку на отримання книги" Height="35" FontWeight="Bold"
                IsDefault="True" Click="CreateLoanRequestButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
