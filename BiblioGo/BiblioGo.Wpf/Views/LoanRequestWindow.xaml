<Window x:Class="BiblioGo.Wpf.Views.LoanRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформити заявку на отримання книги" Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookComboBox}"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock Text="Читач:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock x:Name="ReaderTextBlock" Margin="0,0,0,15" Height="25"/>

        <TextBlock Text="Книга:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="BookComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Філія:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="LibraryComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <Button x:Name="CreateLoanRequestButton" Content="Оформити заявку на отримання книги" Height="35" FontWeight="Bold"
                IsDefault="True" Click="CreateLoanRequestButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
