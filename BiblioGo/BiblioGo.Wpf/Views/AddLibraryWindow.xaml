<Window x:Class="BiblioGo.Wpf.Views.AddLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати нову філію" Height="520" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Border Style="{StaticResource CardBorder}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid Style="{StaticResource TitleBarPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseButton"
                        Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Margin="32,48,32,24">
                <TextBlock Text="Нова філія" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Вкажіть дані нової бібліотеки мережі"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Назва філії" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="NameInput" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Адреса" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="AddressInput" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Контактна інформація (телефон, пошта)" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="ContactInfoInput" Style="{StaticResource InputBox}" Margin="0,0,0,20"/>

                <Button x:Name="AddButton"
                        Content="Додати філію"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="AddButton_Click"/>

                <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
