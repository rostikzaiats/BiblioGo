<Window x:Class="BiblioGo.Wpf.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зміна пароля" Height="470" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Border Style="{StaticResource CardBorder}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid Style="{StaticResource TitleBarPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseButton"
                        Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Margin="32,48,32,24">
                <TextBlock Text="Зміна пароля" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Введіть поточний і новий пароль"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Поточний пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="CurrentPasswordInput" Style="{StaticResource PasswordBoxStyle}"/>

                <TextBlock Text="Новий пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="NewPasswordInput" Style="{StaticResource PasswordBoxStyle}"/>

                <TextBlock Text="Повторіть новий пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,20"/>

                <Button x:Name="ChangeButton"
                        Content="Змінити пароль"
                        Style="{StaticResource PrimaryButton}"
                        Click="ChangeButton_Click"/>

                <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
