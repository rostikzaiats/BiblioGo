<Window x:Class="BiblioGo.Wpf.Views.EditLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагувати філію" Height="520" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Loaded="Window_Loaded">

    <Border Style="{StaticResource CardBorder}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid Style="{StaticResource TitleBarPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseButton"
                        Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Margin="32,48,32,24">
                <TextBlock Text="Редагування філії" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Оберіть філію та змініть її адресу чи контакти"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,0,0,24"/>

                <!-- Binding: список і вибраний елемент беруться з ViewModel -->
                <TextBlock Text="Філія" Style="{StaticResource LabelText}"/>
                <ComboBox Height="38"
                          Margin="0,0,0,16"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding Libraries}"
                          SelectedItem="{Binding SelectedLibrary}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Адреса" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource InputBox}"
                         Margin="0,0,0,16"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Контактна інформація (телефон, пошта)" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource InputBox}"
                         Margin="0,0,0,20"
                         Text="{Binding ContactInfo, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Command: кнопка неактивна, поки CanSave() повертає false -->
                <Button Content="Зберегти зміни"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>

                <TextBlock Style="{StaticResource ErrorText}"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
