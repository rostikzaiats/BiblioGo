<Window x:Class="BiblioGo.Wpf.Views.BookSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пошук книги за назвою" Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TitleTextBox}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Назва книги:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TitleTextBox" Width="300" VerticalContentAlignment="Center"/>
            <Button x:Name="SearchButton" Content="Знайти" Margin="10,0,0,0" Padding="15,3"
                    IsDefault="True" Click="SearchButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <DataGrid x:Name="BooksDataGrid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="*"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*"/>
                <DataGridTextColumn Header="Рік" Binding="{Binding Year}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
