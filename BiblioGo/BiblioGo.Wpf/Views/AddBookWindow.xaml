<Window x:Class="BiblioGo.Wpf.Views.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати нову книгу" Height="580" Width="440"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TitleTextBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Назва:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="TitleTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Автор:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="AuthorTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Жанр:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="GenreTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Рік видання:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="YearTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Опис (необов'язково):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,15" Height="80"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <Button x:Name="AddBookButton" Content="Додати книгу" Height="35" FontWeight="Bold"
                IsDefault="True" Click="AddBookButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
