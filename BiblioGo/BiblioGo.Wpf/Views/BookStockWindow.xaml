<Window x:Class="BiblioGo.Wpf.Views.BookStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Залишки книги" Height="440" Width="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookComboBox}"
        Loaded="Window_Loaded">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Книга:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="BookComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="Selection_Changed"/>

            <TextBlock Text="Філія:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DockPanel>
                <Button x:Name="ShowButton" DockPanel.Dock="Right" Content="Показати" Margin="10,0,0,0" Padding="15,3"
                        IsDefault="True" Click="ShowButton_Click"/>
                <ComboBox x:Name="LibraryComboBox" Height="25" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="Selection_Changed"/>
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <StackPanel x:Name="StockPanel" Margin="0,20,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TitleTextBlock" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="AuthorTextBlock" FontSize="14" Margin="0,2,0,2" TextWrapping="Wrap"/>
            <TextBlock x:Name="ScopeTextBlock" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Усього примірників (без списаних):" Margin="0,0,0,6"/>
                <TextBlock x:Name="TotalTextBlock" Grid.Row="0" Grid.Column="1" FontWeight="Bold" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Доступно (на полицях):" Margin="0,0,0,6"/>
                <TextBlock x:Name="AvailableTextBlock" Grid.Row="1" Grid.Column="1" FontWeight="Bold" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Видано (на руках у читачів):" Margin="0,0,0,6"/>
                <TextBlock x:Name="IssuedTextBlock" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Списано:" Margin="0,0,0,6"/>
                <TextBlock x:Name="WrittenOffTextBlock" Grid.Row="3" Grid.Column="1" FontWeight="Bold" Margin="0,0,0,6"/>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
