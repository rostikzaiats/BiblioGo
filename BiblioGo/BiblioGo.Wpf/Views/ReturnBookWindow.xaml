<Window x:Class="BiblioGo.Wpf.Views.ReturnBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформити повернення книги" Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=LoanIdTextBox}"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock Text="Бібліотекар:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock x:Name="LibrarianTextBlock" Margin="0,0,0,15" Height="25"/>

        <TextBlock Text="Номер заявки:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="LoanIdTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <Button x:Name="ReturnBookButton" Content="Оформити повернення книги" Height="35" FontWeight="Bold"
                IsDefault="True" Click="ReturnBookButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
