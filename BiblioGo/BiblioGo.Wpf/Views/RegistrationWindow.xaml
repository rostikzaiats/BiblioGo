<Window x:Class="BiblioGo.Wpf.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація у BiblioGo" Height="560" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Border Style="{StaticResource CardBorder}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid Style="{StaticResource TitleBarPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseButton"
                        Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Margin="32,48,32,24">
                <TextBlock Text="Створити акаунт" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Приєднуйтесь до BiblioGo"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="EmailInput" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordBoxStyle}"/>

                <TextBlock Text="Ім'я" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="FirstNameInput" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Прізвище" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="LastNameInput" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Телефон" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="PhoneInput" Style="{StaticResource InputBox}" Margin="0,0,0,20"/>

                <Button x:Name="RegisterButton"
                        Content="Зареєструватись"
                        Style="{StaticResource PrimaryButton}"
                        Click="RegisterButton_Click"/>

                <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>