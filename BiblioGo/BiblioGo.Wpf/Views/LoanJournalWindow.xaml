<Window x:Class="BiblioGo.Wpf.Views.LoanJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переглянути журнал позик" Height="600" Width="1050"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Бібліотекар:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="LibrarianTextBlock" VerticalAlignment="Center"/>
            </StackPanel>

            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Філія:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LibraryComboBox" Width="200" Height="25" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="15,0,8,0"/>
                <ComboBox x:Name="StatusComboBox" Width="170" Height="25" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Оформлено з:" VerticalAlignment="Center" Margin="15,0,8,0"/>
                <DatePicker x:Name="DateFromPicker" Width="120" Height="25"
                            ToolTip="Необов'язково. Залиште порожнім, щоб не обмежувати дату"/>

                <TextBlock Text="по:" VerticalAlignment="Center" Margin="10,0,8,0"/>
                <DatePicker x:Name="DateToPicker" Width="120" Height="25"
                            ToolTip="Необов'язково. Залиште порожнім, щоб не обмежувати дату"/>

                <Button x:Name="ShowButton" Content="Переглянути журнал позик" Margin="15,0,0,0" Padding="15,3"
                        IsDefault="True" Click="ShowButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PreviousPageButton" Content="← Попередня" Padding="10,3" IsEnabled="False"
                        Click="PreviousPageButton_Click"/>
                <TextBlock x:Name="PageTextBlock" VerticalAlignment="Center" Margin="15,0" MinWidth="260"
                           TextAlignment="Center"/>
                <Button x:Name="NextPageButton" Content="Наступна →" Padding="10,3" IsEnabled="False"
                        Click="NextPageButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </StackPanel>

        <DataGrid x:Name="LoansDataGrid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заявки" Binding="{Binding LoanId}" Width="Auto"/>
                <DataGridTextColumn Header="Читач" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Книга" Binding="{Binding BookTitle}" Width="2*"/>
                <DataGridTextColumn Header="Інв. №" Binding="{Binding InventoryNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
                <DataGridTextColumn Header="Дата видачі" Binding="{Binding IssueDate}" Width="Auto"/>
                <DataGridTextColumn Header="Повернути до" Binding="{Binding DueDate}" Width="Auto"/>
                <DataGridTextColumn Header="Повернено" Binding="{Binding ReturnDate}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
