<Window x:Class="BiblioGo.Wpf.Views.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Інформація про книгу" Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookComboBox}"
        Loaded="Window_Loaded">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Книга:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DockPanel>
                <Button x:Name="ShowButton" DockPanel.Dock="Right" Content="Показати" Margin="10,0,0,0" Padding="15,3"
                        IsDefault="True" Click="ShowButton_Click"/>
                <ComboBox x:Name="BookComboBox" Height="25" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="BookComboBox_SelectionChanged"/>
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <ScrollViewer x:Name="DetailsPanel" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="AuthorTextBlock" FontSize="14" Margin="0,2,0,10" TextWrapping="Wrap"/>

                <TextBlock x:Name="GenreYearTextBlock" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="Опис:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="DescriptionTextBlock" Margin="0,0,0,15" TextWrapping="Wrap"/>

                <TextBlock Text="Наявність:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="AvailabilityTextBlock" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <DataGrid x:Name="LibrariesDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Філія" Binding="{Binding LibraryName}" Width="*"/>
                        <DataGridTextColumn Header="Адреса" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Вільних примірників" Binding="{Binding AvailableCopies}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
