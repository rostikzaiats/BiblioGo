<Window x:Class="BiblioGo.Wpf.Views.BookCopiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Примірники книги" Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookComboBox}"
        Loaded="Window_Loaded">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Книга:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="BookComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="Selection_Changed"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Філія:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="LibraryComboBox" Grid.Row="1" Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="Selection_Changed"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Статус:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusComboBox" Grid.Row="1" Grid.Column="2" Height="25" VerticalContentAlignment="Center"
                          SelectedIndex="0" SelectionChanged="Selection_Changed">
                    <ComboBoxItem Content="Усі"/>
                    <ComboBoxItem Content="Доступний"/>
                    <ComboBoxItem Content="Виданий"/>
                    <ComboBoxItem Content="Списаний"/>
                </ComboBox>

                <Button x:Name="ShowButton" Grid.Row="1" Grid.Column="3" Content="Показати" Margin="10,0,0,0" Padding="15,3"
                        IsDefault="True" Click="ShowButton_Click"/>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <DataGrid x:Name="CopiesDataGrid" Margin="0,15,0,0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Інв. №" Binding="{Binding InventoryNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Філія" Binding="{Binding LibraryName}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
