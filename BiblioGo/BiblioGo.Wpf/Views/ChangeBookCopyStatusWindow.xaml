<Window x:Class="BiblioGo.Wpf.Views.ChangeBookCopyStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Змінити статус примірника" Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=InventoryNumberTextBox}"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock Text="Бібліотекар:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock x:Name="LibrarianTextBlock" Margin="0,0,0,15" Height="25"/>

        <TextBlock Text="Інвентарний номер примірника:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="InventoryNumberTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock Text="Новий статус:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="StatusComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                  DisplayMemberPath="Name"/>

        <Button x:Name="ChangeStatusButton" Content="Змінити статус примірника" Height="35" FontWeight="Bold"
                IsDefault="True" Click="ChangeStatusButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
