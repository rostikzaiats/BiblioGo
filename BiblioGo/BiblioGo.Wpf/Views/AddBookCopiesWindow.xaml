<Window x:Class="BiblioGo.Wpf.Views.AddBookCopiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати примірники книги" Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookComboBox}"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock Text="Книга:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="BookComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Філія:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="LibraryComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Кількість примірників:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="QuantityTextBox" Text="1" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <Button x:Name="AddCopiesButton" Content="Додати примірники" Height="35" FontWeight="Bold"
                IsDefault="True" Click="AddCopiesButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
