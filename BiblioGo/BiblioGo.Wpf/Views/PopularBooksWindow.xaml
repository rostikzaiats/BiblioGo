<Window x:Class="BiblioGo.Wpf.Views.PopularBooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Популярні книги" Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Період:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PeriodComboBox" Width="170" Height="25" VerticalContentAlignment="Center"
                      DisplayMemberPath="Name" SelectedValuePath="Value"/>

            <TextBlock Text="Показати:" VerticalAlignment="Center" Margin="15,0,8,0"/>
            <ComboBox x:Name="TopComboBox" Width="70" Height="25" VerticalContentAlignment="Center"/>

            <Button x:Name="ShowButton" Content="Показати рейтинг" Margin="15,0,0,0" Padding="15,3"
                    IsDefault="True" Click="ShowButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <DataGrid x:Name="BooksDataGrid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Rank}" Width="Auto"/>
                <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="*"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*"/>
                <DataGridTextColumn Header="Рік" Binding="{Binding Year}" Width="Auto"/>
                <DataGridTextColumn Header="Видач" Binding="{Binding IssueCount}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
