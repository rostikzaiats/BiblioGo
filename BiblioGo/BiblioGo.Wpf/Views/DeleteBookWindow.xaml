<Window x:Class="BiblioGo.Wpf.Views.DeleteBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Видалити книгу з каталогу" Height="270" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookComboBox}"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock Text="Книга:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="BookComboBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Разом з книгою буде видалено всі її примірники. Книгу, за якою є активні заявки або видані примірники, видалити не можна."
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

        <Button x:Name="DeleteButton" Content="Видалити книгу" Height="35" FontWeight="Bold"
                Click="DeleteButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
