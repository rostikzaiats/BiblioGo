<Window x:Class="BiblioGo.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Увійти у BiblioGo" Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Border Style="{StaticResource CardBorder}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid Style="{StaticResource TitleBarPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button x:Name="CloseButton"
                        Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        Margin="0,5,10,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Margin="32,40,32,24">
                <TextBlock Text="З поверненням" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Увійдіть до свого акаунта BiblioGo"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="EmailInput" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordBoxStyle}"
                             Margin="0,0,0,20"/>

                <Button x:Name="LoginButton"
                        Content="Увійти"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>