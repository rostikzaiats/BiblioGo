<Window x:Class="BiblioGo.Wpf.Views.BookCopyWriteOffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Списати примірник" Height="230" Width="420"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=BookCopyIdTextBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Ідентифікатор примірника:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="BookCopyIdTextBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <Button x:Name="WriteOffButton" Content="Списати примірник" Height="35" FontWeight="Bold"
                Click="WriteOffButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
