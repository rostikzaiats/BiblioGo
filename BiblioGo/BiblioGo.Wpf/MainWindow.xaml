<Window x:Class="BiblioGo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BiblioGo.Wpf"
        mc:Ignorable="d"
        Title="BiblioGo" Height="450" Width="800">
    <StackPanel Margin="20">
        <Button x:Name="BookSearchButton" Content="Пошук книги за назвою" HorizontalAlignment="Left"
            Padding="15,5" Click="BookSearchButton_Click"/>
        <Button x:Name="RegistrationButton" Content="Реєстрація" HorizontalAlignment="Left"
            Margin="0,10,0,0" Padding="15,5" Click="RegistrationButton_Click"/>
        <Button x:Name="WriteOffBookCopyButton" Content="Списати примірник" HorizontalAlignment="Left"
            Margin="0,10,0,0" Padding="15,5" Click="WriteOffBookCopyButton_Click"/>
        <Button x:Name="CreateLoanRequestButton" Content="Оформити заявку на отримання книги" HorizontalAlignment="Left"
            Margin="0,10,0,0" Padding="15,5" Click="CreateLoanRequestButton_Click"/>
    </StackPanel>
</Window>
