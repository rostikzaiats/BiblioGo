<Window x:Class="BiblioGo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BiblioGo.Wpf"
        mc:Ignorable="d"
        Title="BiblioGo" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Пункт меню в бічній панелі -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт меню в контенті (картка-кнопка) -->
        <Style x:Key="MenuCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource BorderFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок секції -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LinkBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>

        <!-- Компактна кнопка дії над каталогом -->
        <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource MenuCardButton}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource CardBorder}" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== ШАПКА ==================== -->
            <Grid Grid.Row="0" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BiblioGo: розгортає / згортає панель розділів -->
                <Button x:Name="MenuToggleButton"
                        Grid.Column="0"
                        Content="BiblioGo"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource LinkBrush}"
                        Style="{StaticResource SidebarButton}"
                        Click="MenuToggleButton_Click"/>

                <TextBlock x:Name="SectionTitleText"
                           Grid.Column="1"
                           Text="Каталог"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>

                <!-- Користувач: імʼя + аватар, по кліку випадає меню -->
                <Button x:Name="ProfileButton"
                        Grid.Column="2"
                        Style="{StaticResource SidebarButton}"
                        Click="ProfileButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UserNameText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Border Width="30" Height="30"
                                CornerRadius="15"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock x:Name="AvatarText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Popup x:Name="ProfilePopup"
                       PlacementTarget="{Binding ElementName=ProfileButton}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border x:Name="ProfileMenu"
                            Width="230"
                            Margin="8"
                            Padding="6"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button x:Name="UpdateProfileButton"
                                    Content="Оновити профіль"
                                    Style="{StaticResource SidebarButton}"
                                    Click="UpdateUserProfileButton_Click"/>
                            <Button x:Name="ChangePasswordButton"
                                    Content="Змінити пароль"
                                    Style="{StaticResource SidebarButton}"
                                    Click="ChangePasswordButton_Click"/>
                            <Button x:Name="UserLoansButton"
                                    Content="Мої позики"
                                    Style="{StaticResource SidebarButton}"
                                    Click="UserLoansButton_Click"/>
                            <Button x:Name="ChangeUserRoleButton"
                                    Content="Змінити роль користувача"
                                    Style="{StaticResource SidebarButton}"
                                    Click="ChangeUserRoleButton_Click"/>
                            <Border Height="1"
                                    Margin="8,6"
                                    Background="{StaticResource BorderBrush}"/>
                            <Button x:Name="LogoutButton"
                                    Content="Вийти з акаунта"
                                    Foreground="{StaticResource ErrorBrush}"
                                    Style="{StaticResource SidebarButton}"
                                    Click="LogoutButton_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ==================== ТІЛО ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Панель розділів (за замовчуванням згорнута) -->
                <Border x:Name="SectionsPanel"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Width="200"
                        Margin="20,10,0,24"
                        Padding="8"
                        VerticalAlignment="Top"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="РОЗДІЛИ"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="8,4,0,6"/>
                        <Button x:Name="CatalogSectionButton"
                                Content="Каталог"
                                Style="{StaticResource SidebarButton}"
                                Click="CatalogSectionButton_Click"/>
                        <Button x:Name="FundSectionButton"
                                Content="Фонд"
                                Style="{StaticResource SidebarButton}"
                                Click="FundSectionButton_Click"/>
                        <Button x:Name="LoanSectionButton"
                                Content="Видача та повернення"
                                Style="{StaticResource SidebarButton}"
                                Click="LoanSectionButton_Click"/>
                    </StackPanel>
                </Border>
                <!-- Розділ «Каталог»: каталог книг постійно на екрані, інші дії — компактні кнопки над ним -->
                <DockPanel x:Name="CatalogSection"
                           Grid.Column="1"
                           Margin="32,10,32,24">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="PopularBooksButton"
                            Content="Популярні книги"
                            Style="{StaticResource QuickActionButton}"
                            Click="PopularBooksButton_Click"/>
                        <Button x:Name="BookSearchButton"
                            Content="Пошук за назвою"
                            Style="{StaticResource QuickActionButton}"
                            Click="BookSearchButton_Click"/>
                        <Button x:Name="BookSearchByAuthorButton"
                            Content="Пошук за автором"
                            Style="{StaticResource QuickActionButton}"
                            Click="BookSearchByAuthorButton_Click"/>
                        <Button x:Name="BookDetailsButton"
                            Content="Інформація про книгу"
                            Style="{StaticResource QuickActionButton}"
                            Click="BookDetailsButton_Click"/>
                        <Button x:Name="SimilarBooksButton"
                            Content="Схожі книги"
                            Style="{StaticResource QuickActionButton}"
                            Click="SimilarBooksButton_Click"/>
                    </WrapPanel>
                    <ContentControl x:Name="CatalogHost"/>
                </DockPanel>

                <ScrollViewer x:Name="OtherSectionsScrollViewer"
                              Grid.Column="1"
                              Margin="32,10,32,24"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="FundSection" Visibility="Collapsed">
                            <Button x:Name="AddBookButton"
                                Content="Додати нову книгу"
                                Style="{StaticResource MenuCardButton}"
                                Click="AddBookButton_Click"/>
                            <Button x:Name="UpdateBookButton"
                                Content="Редагувати інформацію про книгу"
                                Style="{StaticResource MenuCardButton}"
                                Click="UpdateBookButton_Click"/>
                            <Button x:Name="DeleteBookButton"
                                Content="Видалити книгу з каталогу"
                                Style="{StaticResource MenuCardButton}"
                                Click="DeleteBookButton_Click"/>
                            <Button x:Name="AddBookCopiesButton"
                                Content="Додати примірники книги"
                                Style="{StaticResource MenuCardButton}"
                                Click="AddBookCopiesButton_Click"/>
                            <Button x:Name="BookStockButton"
                                Content="Переглянути залишки книги"
                                Style="{StaticResource MenuCardButton}"
                                Click="BookStockButton_Click"/>
                            <Button x:Name="WriteOffBookCopyButton"
                                Content="Списати примірник"
                                Style="{StaticResource MenuCardButton}"
                                Click="WriteOffBookCopyButton_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="LoanSection" Visibility="Collapsed">
                            <Button x:Name="CreateLoanRequestButton"
                                Content="Оформити заявку на отримання"
                                Style="{StaticResource MenuCardButton}"
                                Click="CreateLoanRequestButton_Click"/>
                            <Button x:Name="CheckCopyAvailabilityButton"
                                Content="Перевірити наявність примірника перед видачею"
                                Style="{StaticResource MenuCardButton}"
                                Click="CheckCopyAvailabilityButton_Click"/>
                            <Button x:Name="ConfirmLoanIssueButton"
                                Content="Підтвердити та оформити видачу книги"
                                Style="{StaticResource MenuCardButton}"
                                Click="ConfirmLoanIssueButton_Click"/>
                            <Button x:Name="ReturnBookButton"
                                Content="Оформити повернення книги"
                                Style="{StaticResource MenuCardButton}"
                                Click="ReturnBookButton_Click"/>
                            <Button x:Name="ChangeBookCopyStatusButton"
                                Content="Змінити статус примірника"
                                Style="{StaticResource MenuCardButton}"
                                Click="ChangeBookCopyStatusButton_Click"/>
                            <Button x:Name="LoanJournalButton"
                                Content="Переглянути журнал позик"
                                Style="{StaticResource MenuCardButton}"
                                Click="LoanJournalButton_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>