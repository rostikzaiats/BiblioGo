<Window x:Class="BiblioGo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BiblioGo.Wpf"
        mc:Ignorable="d"
        Title="BiblioGo" Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Пункт меню в бічній панелі -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт меню в контенті (картка-кнопка) -->
        <Style x:Key="MenuCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource BorderFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок секції -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LinkBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource CardBorder}" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== БІЧНА ПАНЕЛЬ ==================== -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Row="0" Margin="20,22,20,0">
                        <TextBlock Text="BiblioGo"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource LinkBrush}"/>
                        <TextBlock Text="Library System"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Навігація -->
                    <StackPanel Grid.Row="1" Margin="12,24,12,0">
                        <TextBlock Text="КОРИСТУВАЧ"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,6"/>

                        <Button x:Name="LoginButton"
                                Content="Увійти"
                                Style="{StaticResource SidebarButton}"
                                Click="LoginButton_Click"/>
                        <Button x:Name="RegistrationButton"
                                Content="Реєстрація"
                                Style="{StaticResource SidebarButton}"
                                Click="RegistrationButton_Click"/>
                        <Button x:Name="UpdateProfileButton"
                                Content="Оновити профіль"
                                Style="{StaticResource SidebarButton}"
                                Click="UpdateUserProfileButton_Click"/>
                        <Button x:Name="UserLoansButton"
                                Content="Мої позики"
                                Style="{StaticResource SidebarButton}"
                                Click="UserLoansButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,22,20,0">
                    <TextBlock Text="Головне меню"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1"
                              Margin="32,10,32,24"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="КАТАЛОГ" Style="{StaticResource SectionTitle}" Margin="2,0,0,8"/>
                        <Button x:Name="BookSearchButton"
                                Content="Пошук книги за назвою"
                                Style="{StaticResource MenuCardButton}"
                                Click="BookSearchButton_Click"/>
                        <Button x:Name="BookSearchByAuthorButton"
                                Content="Пошук книги за автором"
                                Style="{StaticResource MenuCardButton}"
                                Click="BookSearchByAuthorButton_Click"/>
                        <Button x:Name="CreateLoanRequestButton"
                                Content="Оформити заявку на отримання"
                                Style="{StaticResource MenuCardButton}"
                                Click="CreateLoanRequestButton_Click"/>

                        <TextBlock Text="АДМІНІСТРУВАННЯ ФОНДУ"
                                   Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <Button x:Name="AddBookCopiesButton"
                                Content="Додати примірники книги"
                                Style="{StaticResource MenuCardButton}"
                                Click="AddBookCopiesButton_Click"/>
                        <Button x:Name="WriteOffBookCopyButton"
                                Content="Списати примірник"
                                Style="{StaticResource MenuCardButton}"
                                Click="WriteOffBookCopyButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>